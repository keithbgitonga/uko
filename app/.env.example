# API
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# DEV ONLY: expose OTP code in the response for the walking skeleton
EXPOSE_DEV_OTP=true

# Database (PostGIS)
DATABASE_URL=postgres://uko:uko@localhost:5432/uko

# Redis / MQTT (used from Sprint 2)
REDIS_URL=redis://localhost:6379
MQTT_URL=ws://localhost:8083/mqtt

# SMS delivery (dev logs the code; africastalking uses AT_* credentials)
SMS_PROVIDER=dev
# Override for fake/local gateway tests:
SMS_BASE_URL=https://api.africastalking.com
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Dispatch console allow-list (comma-separated E.164 phones; empty = any authenticated user)
DISPATCH_PHONES=+254712345678

# OTP rate limits
OTP_RATE_PER_PHONE_HOUR=3
OTP_RATE_PER_IP_HOUR=10
OTP_VERIFY_PER_PHONE10MIN=10

# M-Pesa: mock (simulated STK) or daraja (real sandbox/production)
MPESA_PROVIDER=mock
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_CALLBACK_URL=
DARAJA_CALLBACK_SECRET=

# Push notifications: dev (log) or fcm (Firebase legacy endpoint/fake gateway in tests)
PUSH_PROVIDER=dev
PUSH_BASE_URL=https://fcm.googleapis.com
FCM_SERVER_KEY=

# Require approved licence + insurance before a driver can go online (pilot gate)
DOCUMENTS_REQUIRED=false

# Optional Slack-compatible webhook for alert delivery
ALERT_WEBHOOK_URL=

# Firebase Cloud Messaging HTTP v1 (service account; preferred)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_OAUTH_URL=https://oauth2.googleapis.com/token
